    <worksheet name='Pickup Activity Heatmap'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='18'>When Are NYC Yellow Taxi Pickups Busiest?</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'>Average pickups per weekday/hour | Jan 2015 and Jan–Mar 2016</run>
            <run>Æ&#10;&#10;</run>
          </formatted-text>
        </title>
        <caption>
          <formatted-text>
            <run fontcolor='#000000' fontname='Benton Sans Book'>Source: NYC TLC via Kaggle. Cleaned 25% sample. Each cell shows average pickups during a one-hour period across the observed dates for that weekday. Darker colours indicate higher pickup activity.</run>
          </formatted-text>
        </caption>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='yellow_taxi_clean_full-001' name='federated.1cnqtdk1prbkg313os0de163bfs3' />
          </datasources>
          <datasource-dependencies datasource='federated.1cnqtdk1prbkg313os0de163bfs3'>
            <column caption='Pickup Weekday' datatype='string' name='[Calculation_0867430012522496]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [pickup_dow]&#10;WHEN 0 THEN &quot;Monday&quot;&#10;WHEN 1 THEN &quot;Tuesday&quot;&#10;WHEN 2 THEN &quot;Wednesday&quot;&#10;WHEN 3 THEN &quot;Thursday&quot;&#10;WHEN 4 THEN &quot;Friday&quot;&#10;WHEN 5 THEN &quot;Saturday&quot;&#10;WHEN 6 THEN &quot;Sunday&quot;&#10;END' />
            </column>
            <column caption='Pickup Date' datatype='date' name='[Calculation_0867430012960769]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE([tpep_pickup_datetime])' />
            </column>
            <column caption='Trip Count' datatype='integer' name='[Calculation_0867430013165570]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1' />
            </column>
            <column caption='Weekday Occurrences' datatype='integer' name='[Calculation_0867430013296643]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [Calculation_0867430012522496] : COUNTD([Calculation_0867430012960769]) }' />
            </column>
            <column caption='Average Pickups per Hour' datatype='real' default-format='n0;-0' name='[Calculation_0867430013411332]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_0867430013165570]) / MIN([Calculation_0867430013296643])' />
            </column>
