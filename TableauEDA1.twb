    <worksheet name='Trip Length by Passenger Group'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='18'>Do Larger Passenger Groups Take Longer Trips?</run>
            <run fontcolor='#000000' fontname='Benton Sans Book'>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='12' italic='true'>Cleaned 25% sample | Jan 2015 and Jan–Mar 2016</run>
          </formatted-text>
        </title>
        <caption>
          <formatted-text>
            <run fontcolor='#000000' fontname='Benton Sans Book'>Short trips dominate every passenger group. Long trips account for roughly 13–15%, so trip-length patterns are similar. The share of long trips does not increase steadily with passenger-group size.</run>
          </formatted-text>
        </caption>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='yellow_taxi_clean_full-001' name='federated.1cnqtdk1prbkg313os0de163bfs3' />
          </datasources>
          <datasource-dependencies datasource='federated.1cnqtdk1prbkg313os0de163bfs3'>
            <column caption='Trip Count' datatype='integer' name='[Calculation_0867430013165570]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1' />
            </column>
            <column caption='Passenger Group' datatype='string' name='[Calculation_0867430033489928]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [passenger_count] = 1 THEN &quot;1 passenger&quot;&#10;ELSEIF [passenger_count] = 2 THEN &quot;2 passengers&quot;&#10;ELSEIF [passenger_count] &gt;= 3&#10;   AND [passenger_count] &lt;= 6 THEN &quot;3–6 passengers&quot;&#10;END' />
            </column>
            <column caption='Trip Length Group' datatype='string' name='[Calculation_0867430034247690]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [trip_distance] &lt; 2 THEN &quot;Short (&lt;2 miles)&quot;&#10;ELSEIF [trip_distance] &lt; 5 THEN &quot;Medium (2–&lt;5 miles)&quot;&#10;ELSE &quot;Long (5+ miles)&quot;&#10;END' />
            </column>
            <column-instance column='[Calculation_0867430033489928]' derivation='None' name='[none:Calculation_0867430033489928:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_0867430034247690]' derivation='None' name='[none:Calculation_0867430034247690:nk]' pivot='key' type='nominal' />
            <column caption='Passenger Count' datatype='integer' name='[passenger_count]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_0867430013165570]' derivation='Sum' name='[pcto:sum:Calculation_0867430013165570:qk:2]' pivot='key' type='quantitative'>
              <table-calc ordering-field='[federated.1cnqtdk1prbkg313os0de163bfs3].[none:Calculation_0867430034247690:nk]' ordering-type='Field' type='PctTotal' />
            </column-instance>
            <column caption='Trip Distance' datatype='real' name='[trip_distance]' role='measure' type='quantitative' />
          </datasource-dependencies>
          <manual-sort column='[federated.1cnqtdk1prbkg313os0de163bfs3].[none:Calculation_0867430034247690:nk]' direction='ASC'>
            <dictionary>
              <bucket>&quot;Short (&lt;2 miles)&quot;</bucket>
              <bucket>&quot;Medium (2–&lt;5 miles)&quot;</bucket>
              <bucket>&quot;Long (5+ miles)&quot;</bucket>
            </dictionary>
          </manual-sort>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='axis'>
            <format attr='title' class='0' field='[federated.1cnqtdk1prbkg313os0de163bfs3].[pcto:sum:Calculation_0867430013165570:qk:2]' scope='rows' value='Percentage of trips within passenger group' />
          </style-rule>
          <style-rule element='label'>
            <format attr='text-format' field='[federated.1cnqtdk1prbkg313os0de163bfs3].[pcto:sum:Calculation_0867430013165570:qk:2]' value='p0.0%' />
          </style-rule>
        </style>
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Bar' />
            <encodings>
              <color column='[federated.1cnqtdk1prbkg313os0de163bfs3].[none:Calculation_0867430034247690:nk]' />
            </encodings>
            <style>
              <style-rule element='mark'>
                <format attr='mark-labels-show' value='true' />
                <format attr='mark-labels-cull' value='true' />
              </style-rule>
            </style>
          </pane>
        </panes>
        <rows>[federated.1cnqtdk1prbkg313os0de163bfs3].[pcto:sum:Calculation_0867430013165570:qk:2]</rows>
        <cols>([federated.1cnqtdk1prbkg313os0de163bfs3].[none:Calculation_0867430033489928:nk] / [federated.1cnqtdk1prbkg313os0de163bfs3].[none:Calculation_0867430034247690:nk])</cols>
      </table>
